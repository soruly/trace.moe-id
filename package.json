{
  "name": "trace.moe-id",
  "version": "2.0.0",
  "description": "Fast, zero-dependency, isomorphic visual feature descriptor library (MPEG-7, CEDD, FCTH, JCD, AutoColorCorrelogram, OpponentHistogram)",
  "keywords": [
    "cbir",
    "cedd",
    "color-layout",
    "edge-histogram",
    "fcth",
    "image-descriptors",
    "image-features",
    "jcd",
    "lire",
    "mpeg-7",
    "reverse-image-search",
    "trace.moe",
    "visual-features"
  ],
  "homepage": "https://github.com/soruly/trace.moe-id",
  "bugs": {
    "url": "https://github.com/soruly/trace.moe-id/issues"
  },
  "license": "MIT",
  "author": "soruly",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soruly/trace.moe-id.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build && npm test",
    "bench": "node test/benchmark.js",
    "format": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "oxfmt --check && oxlint && node --test test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
